# DVD Cabinet settings. Copy to .env and edit; command-line flags override these.

# Where the server keeps its database (accounts, library folders) and thumbnails.
# Relative to this folder, or absolute. With Docker, point this at a volume.
DVD_DATA_DIR=data

# A library folder to start with on the very first run (relative or absolute).
# After that, library folders are managed on the Server settings page.
DVD_LIBRARY=DVDs

# Web server
DVD_HOST=0.0.0.0
DVD_PORT=8080

# Video quality: lower is better and uses more bandwidth (18-23 is sensible)
DVD_CRF=20

# WebRTC codec: auto (H.264 when the browser supports it), h264 or vp8
DVD_WEBRTC_CODEC=auto

# For WebRTC from outside your network: one UDP port, forwarded by your router to
# this machine (same port on both sides), and your router's public IP address.
# Leave both empty for home-network-only use.
DVD_RTC_PORT=
DVD_PUBLIC_IP=
